{
  "name": "hydra-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/server",
    "packages/client",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev -w examples/buzzer"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
